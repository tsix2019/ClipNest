<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CardBodyBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="CardTextBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="CardSubtleTextBrush" Color="#8A000000" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="TabSelectedBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="TabHoverBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="SearchBoxBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#CC1F1F1F" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#B3FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CardBodyBrush" Color="#FF2B2B2D" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="CardTextBrush" Color="#F0FFFFFF" />
            <SolidColorBrush x:Key="CardSubtleTextBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="#33000000" />
            <SolidColorBrush x:Key="TabSelectedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="TabHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SearchBoxBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="BadgeBrush" Color="#E6F2F2F2" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="#FF111111" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="#0DFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CardBodyBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CardTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CardSubtleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TabSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TabHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SearchBoxBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BadgeTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SettingsCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="CardCornerRadiusValue">12</x:Double>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <x:Double x:Key="CardHeaderHeight">48</x:Double>

    <!-- Card container: no default list visuals; selection drawn as an accent ring. -->
    <Style x:Key="CardContainerStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="7,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        SelectionCheckMarkVisualEnabled="False"
                        CheckMode="Overlay"
                        CornerRadius="15"
                        Padding="3"
                        Background="Transparent"
                        PointerOverBackground="Transparent"
                        PressedBackground="Transparent"
                        SelectedBackground="Transparent"
                        SelectedPointerOverBackground="Transparent"
                        SelectedPressedBackground="Transparent"
                        SelectedBorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        SelectedBorderThickness="3"
                        SelectedPointerOverBorderBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                        PointerOverBorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="0"
                        FocusVisualPrimaryBrush="Transparent"
                        FocusVisualSecondaryBrush="Transparent"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        ContentMargin="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="CardMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource CardSubtleTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CardBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{ThemeResource CardTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <!-- Pinboard tab -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="64" />
    </Style>
</ResourceDictionary>
