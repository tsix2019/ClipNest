<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClipNest.App.Views.CardHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="{StaticResource CardHeaderHeight}" Padding="12,0,10,0" ColumnSpacing="8"
          CornerRadius="11,11,0,0"
          Background="{x:Bind Item.HeaderBrush, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{x:Bind Item.DisplayTitle, Mode=OneWay}"
                       Foreground="{x:Bind Item.HeaderForeground, Mode=OneWay}"
                       Style="{StaticResource CardTitleStyle}" />
            <TextBlock Text="{x:Bind Item.TimeText, Mode=OneWay}"
                       Foreground="{x:Bind Item.HeaderForeground, Mode=OneWay}"
                       FontSize="11" Opacity="0.78" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <FontIcon Grid.Column="1" Glyph="&#xE840;" FontSize="13" VerticalAlignment="Center"
                  Foreground="{x:Bind Item.HeaderForeground, Mode=OneWay}"
                  Visibility="{x:Bind Item.TopVisibility, Mode=OneWay}" />
        <Image Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center"
               Source="{x:Bind Item.AppIcon, Mode=OneWay}"
               Visibility="{x:Bind Item.Metrics.IconVisibility, Mode=OneWay}"
               ToolTipService.ToolTip="{x:Bind Item.AppName, Mode=OneWay}" />
    </Grid>
</UserControl>
