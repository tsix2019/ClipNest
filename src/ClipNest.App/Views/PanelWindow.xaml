<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClipNest.App.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:ClipNest.App"
    xmlns:vm="using:ClipNest.App.ViewModels"
    xmlns:views="using:ClipNest.App.Views"
    Title="ClipNest">

    <Grid x:Name="Root"
          Background="{ThemeResource PanelTintBrush}"
          PreviewKeyDown="Root_PreviewKeyDown"
          PreviewKeyUp="Root_PreviewKeyUp"
          CharacterReceived="Root_CharacterReceived">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <Grid.Resources>
            <!-- ===== Card templates ===== -->
            <DataTemplate x:Key="TextCardTemplate" x:DataType="vm:ClipCardViewModel">
                <Grid Width="{x:Bind Metrics.Width, Mode=OneWay}" Height="{x:Bind Metrics.Height, Mode=OneWay}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Background="{ThemeResource CardBodyBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:CardHeader Item="{x:Bind}" />
                    <TextBlock Grid.Row="1" Margin="12,10,12,4"
                               Text="{x:Bind PreviewText, Mode=OneWay}"
                               MaxLines="{x:Bind Metrics.TextMaxLines, Mode=OneWay}"
                               FontFamily="{x:Bind PreviewFont, Mode=OneWay}"
                               Style="{StaticResource CardBodyTextStyle}" />
                    <TextBlock Grid.Row="2" Margin="12,2,12,9"
                               Text="{x:Bind MetaText, Mode=OneWay}"
                               Visibility="{x:Bind Metrics.FooterVisibility, Mode=OneWay}"
                               Style="{StaticResource CardMetaStyle}" />
                    <Border Grid.RowSpan="3" Margin="-1" CornerRadius="12" BorderThickness="2.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    <views:QuickBadge Grid.RowSpan="3" Item="{x:Bind}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ImageCardTemplate" x:DataType="vm:ClipCardViewModel">
                <Grid Width="{x:Bind Metrics.Width, Mode=OneWay}" Height="{x:Bind Metrics.Height, Mode=OneWay}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Background="{ThemeResource CardBodyBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:CardHeader Item="{x:Bind}" />
                    <Border Grid.Row="1" CornerRadius="{x:Bind Metrics.BodyCornerRadius, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="12,6,12,9"
                               Text="{x:Bind MetaText, Mode=OneWay}"
                               Visibility="{x:Bind Metrics.FooterVisibility, Mode=OneWay}"
                               Style="{StaticResource CardMetaStyle}" />
                    <Border Grid.RowSpan="3" Margin="-1" CornerRadius="12" BorderThickness="2.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    <views:QuickBadge Grid.RowSpan="3" Item="{x:Bind}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LinkCardTemplate" x:DataType="vm:ClipCardViewModel">
                <Grid Width="{x:Bind Metrics.Width, Mode=OneWay}" Height="{x:Bind Metrics.Height, Mode=OneWay}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Background="{ThemeResource CardBodyBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:CardHeader Item="{x:Bind}" />
                    <StackPanel Grid.Row="1" Margin="14,0" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE71B;" FontSize="22" HorizontalAlignment="Left"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind LinkHost}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{ThemeResource CardTextBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{x:Bind LinkTitle, Mode=OneWay}" Visibility="{x:Bind LinkTitleVisibility, Mode=OneWay}"
                                   MaxLines="3" Style="{StaticResource CardBodyTextStyle}"
                                   Foreground="{ThemeResource CardSubtleTextBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="12,2,12,9"
                               Text="{x:Bind MetaText, Mode=OneWay}"
                               Visibility="{x:Bind Metrics.FooterVisibility, Mode=OneWay}"
                               Style="{StaticResource CardMetaStyle}" />
                    <Border Grid.RowSpan="3" Margin="-1" CornerRadius="12" BorderThickness="2.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    <views:QuickBadge Grid.RowSpan="3" Item="{x:Bind}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ColorCardTemplate" x:DataType="vm:ClipCardViewModel">
                <Grid Width="{x:Bind Metrics.Width, Mode=OneWay}" Height="{x:Bind Metrics.Height, Mode=OneWay}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Background="{ThemeResource CardBodyBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:CardHeader Item="{x:Bind}" />
                    <Border Grid.Row="1" Background="{x:Bind ColorBrush}" CornerRadius="{x:Bind Metrics.BodyCornerRadius, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ColorText}" Foreground="{x:Bind ColorForeground}"
                                   FontSize="20" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="2" Margin="12,6,12,9"
                               Text="{x:Bind MetaText}"
                               Visibility="{x:Bind Metrics.FooterVisibility, Mode=OneWay}"
                               Style="{StaticResource CardMetaStyle}" />
                    <Border Grid.RowSpan="3" Margin="-1" CornerRadius="12" BorderThickness="2.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    <views:QuickBadge Grid.RowSpan="3" Item="{x:Bind}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="FileCardTemplate" x:DataType="vm:ClipCardViewModel">
                <Grid Width="{x:Bind Metrics.Width, Mode=OneWay}" Height="{x:Bind Metrics.Height, Mode=OneWay}"
                      CornerRadius="{StaticResource CardCornerRadius}"
                      Background="{ThemeResource CardBodyBrush}"
                      BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <views:CardHeader Item="{x:Bind}" />
                    <Border Grid.Row="1" CornerRadius="{x:Bind Metrics.BodyCornerRadius, Mode=OneWay}"
                            Visibility="{x:Bind FilePreviewVisibility, Mode=OneWay}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind FileVisual, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8" Margin="12,0"
                                Visibility="{x:Bind FileInfoVisibility, Mode=OneWay}">
                        <Grid Height="48" HorizontalAlignment="Center">
                            <FontIcon Glyph="{x:Bind FileGlyph, Mode=OneWay}" FontSize="40"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind FileGlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind FileVisual, Mode=OneWay}" Width="48" Height="48"
                                   Visibility="{x:Bind FileIconVisibility, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind FileName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource CardTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind FileDirectory}" Style="{StaticResource CardMetaStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="12,2,12,9"
                               Text="{x:Bind MetaText, Mode=OneWay}"
                               Visibility="{x:Bind Metrics.FooterVisibility, Mode=OneWay}"
                               Style="{StaticResource CardMetaStyle}" />
                    <Border Grid.RowSpan="3" Margin="-1" CornerRadius="12" BorderThickness="2.5" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                    <views:QuickBadge Grid.RowSpan="3" Item="{x:Bind}" />
                </Grid>
            </DataTemplate>

            <views:KindTemplateSelector x:Key="KindSelector"
                TextTemplate="{StaticResource TextCardTemplate}"
                ImageTemplate="{StaticResource ImageCardTemplate}"
                LinkTemplate="{StaticResource LinkCardTemplate}"
                ColorTemplate="{StaticResource ColorCardTemplate}"
                FileTemplate="{StaticResource FileCardTemplate}" />

            <!-- The window itself slides in from its edge (PanelWindow.StartSlide); the content fades. -->
            <Storyboard x:Name="ShowStoryboard">
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.18" />
            </Storyboard>

            <Storyboard x:Name="HideStoryboard">
                <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                 To="0" Duration="0:0:0.12" />
            </Storyboard>

            <ItemsPanelTemplate x:Key="HorizontalCardsPanel">
                <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="VerticalCardsPanel">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Resize grip on the panel's inner edge (placed by PanelWindow.ApplyEdge) -->
        <views:SizingGrip x:Name="ResizeGrip" Height="8" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="ResizeGrip_PointerPressed"
                PointerMoved="ResizeGrip_PointerMoved"
                PointerReleased="ResizeGrip_PointerReleased"
                PointerCaptureLost="ResizeGrip_PointerCaptureLost"
                Canvas.ZIndex="10">
            <Border x:Name="GripBar" Width="36" Height="4" CornerRadius="2" Margin="0,3,0,0" VerticalAlignment="Top"
                    Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" Opacity="0.5" />
        </views:SizingGrip>

        <!-- ===== Top bar ===== -->
        <!-- One row along the top/bottom edge; on the left/right edge the tabs move below the search box. -->
        <Grid x:Name="TopBar" Grid.Row="0" Padding="18,10,12,2" ColumnSpacing="10" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SearchColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SearchArea" ColumnSpacing="4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Width="260" Height="34" VerticalAlignment="Center"
                         PlaceholderText="{l:Tr Key=Panel_Search}"
                         CornerRadius="9"
                         TextChanged="SearchBox_TextChanged"
                         IsSpellCheckEnabled="False" />
                <Button x:Name="FilterButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="FilterButton_Click"
                        ToolTipService.ToolTip="{l:Tr Key=Filter_Button}">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                </Button>
            </Grid>

            <ScrollViewer x:Name="TabsScroller" Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <ItemsRepeater x:Name="TabsRepeater" ItemsSource="{x:Bind ViewModel.Tabs}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PinboardTabViewModel">
                                <Button Style="{StaticResource TabButtonStyle}"
                                        Background="{x:Bind Background, Mode=OneWay}"
                                        Click="{x:Bind Select}"
                                        RightTapped="Tab_RightTapped"
                                        AllowDrop="True"
                                        DragOver="Tab_DragOver"
                                        Drop="Tab_Drop"
                                        Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" Visibility="{x:Bind HistoryIconVisibility}" />
                                        <Ellipse Width="9" Height="9" Fill="{x:Bind DotBrush, Mode=OneWay}"
                                                 Visibility="{x:Bind DotVisibility}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button x:Name="NewPinboardButton" Style="{StaticResource IconButtonStyle}"
                            Click="NewPinboard_Click" ToolTipService.ToolTip="{l:Tr Key=Panel_NewPinboard}">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="RightButtons" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PausedPill" Visibility="Collapsed" Click="PausedPill_Click"
                        CornerRadius="12" Padding="10,3" BorderThickness="0"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE769;" FontSize="12" />
                        <TextBlock Text="{l:Tr Key=Panel_Paused}" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button x:Name="NewTextButton" Style="{StaticResource IconButtonStyle}" Click="NewText_Click"
                        ToolTipService.ToolTip="{l:Tr Key=Panel_NewText}">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Settings_Click"
                        ToolTipService.ToolTip="{l:Tr Key=Panel_Settings}">
                    <FontIcon Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Cards ===== -->
        <ListView x:Name="CardList" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  ItemTemplateSelector="{StaticResource KindSelector}"
                  ItemContainerStyle="{StaticResource CardContainerStyle}"
                  SelectionMode="Extended"
                  IsItemClickEnabled="False"
                  CanDragItems="True"
                  DragItemsStarting="CardList_DragItemsStarting"
                  DoubleTapped="CardList_DoubleTapped"
                  RightTapped="CardList_RightTapped"
                  ItemsPanel="{StaticResource HorizontalCardsPanel}"
                  Padding="11,8,11,14"
                  ScrollViewer.HorizontalScrollMode="Enabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.IsHorizontalRailEnabled="True">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE77F;" FontSize="34" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
