<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClipNest.App.Views.QuickBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">

    <Border Margin="0,0,8,8" MinWidth="22" Height="22" Padding="6,0" CornerRadius="6"
            Background="{ThemeResource BadgeBrush}"
            Visibility="{x:Bind Item.BadgeVisibility, Mode=OneWay}">
        <TextBlock Text="{x:Bind Item.BadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{ThemeResource BadgeTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
</UserControl>
